@startuml
!theme toy
top to bottom direction

package "com.example.starlet_be.domains.connection" {

    class Star << (E,Gray) External Entity >>
    class Constellation << (E,Gray) External Entity >>

    class ConnectionDto << (D,#FFEEEE) Req DTO >> {
        - startStarId: Long
        - endStarId: Long
        --
        + ConnectionDto(startStarId: Long, endStarId: Long) (Builder)
        + getStartStarId(): Long
        + getEndStarId(): Long
    }

    class StarryNightConnectionDto << (D,#EEFFFF) Res DTO >> {
        - connectionId: Long
        - startStarId: Long
        - endStarId: Long
        --
        + StarryNightConnectionDto(...) (Builder)
        + getConnectionId(): Long
        + getStartStarId(): Long
        + getEndStarId(): Long
    }

    class Connection << (E,#FFFFAA) Entity >> {
        - id: Long
        - constellation: Constellation (ManyToOne)
        - start: Star (ManyToOne)
        - end: Star (ManyToOne)
        --
        + Connection(constellation: Constellation, start: Star, end: Star) (Builder)
        + getId(): Long
        + getConstellation(): Constellation
        + getStart(): Star
        + getEnd(): Star
    }

    interface ConnectionRepository << (R,#CCFFCC) JpaRepository >> {
        + findByConstellation(constellation: Constellation): List<Connection>
    }

    Connection "0..*" *-- "1" Constellation : <<ManyToOne>> belongs to
    Connection "0..*" *-- "1" Star : <<ManyToOne>> starts at
    Connection "0..*" *-- "1" Star : <<ManyToOne>> ends at

    ConnectionRepository --> Connection : manages
}
@enduml