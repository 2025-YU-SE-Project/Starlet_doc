@startuml
!theme toy
top to bottom direction

package "com.example.starlet_be.domains.constellation" {

    ' --- External Dependencies (Gray) ---
    class User << (E,Gray) External Entity >>
    class Star << (E,Gray) External Entity >>
    class Connection << (E,Gray) External Entity >>
    enum Color << (E,Gray) External Enum >>
    class Pageable << (I,Gray) Spring Data >>
    class StarsIdDto << (D,Gray) External Req DTO >>
    class StarPositionDto << (D,Gray) External Req DTO >>
    class ConnectionDto << (D,Gray) External Req DTO >>
    class StarryNightStarDto << (D,Gray) External Res DTO >>
    class StarryNightConnectionDto << (D,Gray) External Res DTO >>
    class StarArchiveDto << (D,Gray) External Res DTO >>
    class StarArchiveDetailDto << (D,Gray) External Res DTO >>
    class ConstellationMapper << (C,Gray) External Component >>
    class OpenAIService << (S,Gray) External Service >>
    class ModerationService << (S,Gray) External Service >>

    ' --- Entities ---
    class Constellation << (E,#FFFFAA) Entity >> {
        - id: Long
        - user: User (ManyToOne)
        - name: String
        - description: String
        - createAt: LocalDate
        - belongDate: LocalDate
        - isRepresentative: boolean
        - x: Double
        - y: Double
        - stars: List<Star> (OneToMany)
        - connections: List<Connection> (OneToMany)
        --
        + Constellation(...) (Builder)
        + changeRepresentative()
        + changePosition(x: Double, y: Double)
        + updateInfo(name: String, description: String)
        + setBelongDate(belongDate: LocalDate)
    }
    Constellation "1" o-- "0..*" Star : <<OneToMany>> contains
    Constellation "1" o-- "0..*" Connection : <<OneToMany>> contains

    interface ConstellationRepository << (R,#CCFFCC) JpaRepository >> {
        + findByUserAndBelongDateBetween(...): List<Constellation>
        + findByUser(User user): List<Constellation>
        + findByUserAndIsRepresentative(...): Optional<Constellation>
        + countByUser(User user): long
        + findAllByUserAndCreateAtBetween(...): List<Constellation>
    }
    ConstellationRepository --> Constellation : manages

    ' --- Shared DTOs (Request) ---
    class CreateConstellationDto << (D,#FFEEEE) Req DTO >> {
        - name: String
        - description: String
        - stars: List<StarPositionDto>
        - connections: List<ConnectionDto>
    }
    CreateConstellationDto o-- StarPositionDto
    CreateConstellationDto o-- ConnectionDto

    class ConstellationPositionDto << (D,#FFEEEE) Req DTO >> {
        - x: Double
        - y: Double
    }

    class UpdateConstellationDto << (D,#FFEEEE) Req DTO >> {
        - name: String
        - description: String
    }

    ' --- Shared DTOs (Response) ---
    class ConstellationNameSuggestDto << (D,#EEFFFF) Res DTO >> {
        - name: String
        - description: String
    }

    class StarryNightConstellationDto << (D,#EEFFFF) Res DTO >> {
        - constellationId: Long
        ...
        - stars: List<StarryNightStarDto>
        - connections: List<StarryNightConnectionDto>
    }
    StarryNightConstellationDto o-- StarryNightStarDto
    StarryNightConstellationDto o-- StarryNightConnectionDto

    class ArchiveDto << (D,#EEFFFF) Res DTO >> {
        - constellationId: Long
        ...
        - stars: List<StarArchiveDto>
        - connections: List<ConnectionDto>
    }
    ArchiveDto o-- StarArchiveDto
    ArchiveDto o-- ConnectionDto

    class ArchiveDetailDto << (D,#EEFFFF) Res DTO >> {
        - constellationId: Long
        ...
        - stars: List<StarArchiveDetailDto>
        - connections: List<ConnectionDto>
        - happynessCount: Integer
        ...
        - sadnessCount: Integer
    }
    ArchiveDetailDto o-- StarArchiveDetailDto
    ArchiveDetailDto o-- ConnectionDto

    ' --- Service (Central Logic) ---
    class ConstellationService << (S,#AADDFF) Service >> {
        - constellationRepository: ConstellationRepository
        - starRepository: StarRepository
        - connectionRepository: ConnectionRepository
        - userRepository: UserRepository
        - openAIService: OpenAIService
        - moderationService: ModerationService
        - constellationMapper: ConstellationMapper
        --
        + createConstellation(userDetails, dto: CreateConstellationDto): void
        + repositionConstellation(id: Long, dto: ConstellationPositionDto): void
        + updateConstellationInfo(id: Long, dto: UpdateConstellationDto): void
        + changeRepresentativeConstellation(id: Long, userDetails): void
        + suggestConstellationName(dto: StarsIdDto): ConstellationNameSuggestDto
        + getStarryNightConstellation(userDetails, year, month): List<StarryNightConstellationDto>
        + getArchiveList(userDetails): List<ArchiveDto>
        + getArchivePaging(userDetails, pageable: Pageable): Page<ArchiveDto>
        + getArchiveDetail(id: Long): ArchiveDetailDto
    }
    ConstellationService --> ConstellationRepository
    ConstellationService --> ConstellationMapper : uses
    ConstellationService --> OpenAIService : uses
    ConstellationService --> ModerationService : uses


    ' =====================================================================
    ' --- Functional Modules (Refactored Controllers/APIs) ---
    ' =====================================================================

    package "domains.starrynight" {
        interface StarryNightApi << (I,#CCCCCC) API Interface >> {
            + getStarryNightConstellation(...): ResponseEntity<?>
            + createConstellation(...): ResponseEntity<?>
            + repositionConstellation(...): ResponseEntity<?>
            + suggestConstellationName(...): ResponseEntity<?>
        }

        class StarryNightController << (C,#FFCCAA) RestController >> {
            - starService: StarService
            - constellationService: ConstellationService
            --
            + getStarryNightConstellation(...): ResponseEntity<?>
            + createConstellation(...): ResponseEntity<?>
            + repositionConstellation(...): ResponseEntity<?>
            + suggestConstellationName(...): ResponseEntity<?>
        }

        StarryNightController .up.|> StarryNightApi : implements
        StarryNightController --> ConstellationService : injects/uses
        StarryNightController ..> CreateConstellationDto : uses
        StarryNightController ..> ConstellationPositionDto : uses
        StarryNightController ..> StarsIdDto : uses
    }

    package "domains.archive" {
        interface ArchiveApi << (I,#CCCCCC) API Interface >> {
            + getArchiveList(...): ResponseEntity<?>
            + getArchivePaging(...): ResponseEntity<?>
            + getArchiveDetail(...): ResponseEntity<?>
            + updateConstellationInfo(...): ResponseEntity<?>
            + changeRepresentativeConstellation(...): ResponseEntity<?>
        }

        class ArchiveController << (C,#FFCCAA) RestController >> {
            - constellationService: ConstellationService
            --
            + getArchiveList(...): ResponseEntity<?>
            + getArchivePaging(...): ResponseEntity<?>
            + getArchiveDetail(...): ResponseEntity<?>
            + updateConstellationInfo(...): ResponseEntity<?>
            + changeRepresentativeConstellation(...): ResponseEntity<?>
        }

        ArchiveController .up.|> ArchiveApi : implements
        ArchiveController --> ConstellationService : injects/uses
        ArchiveController ..> UpdateConstellationDto : uses
        ArchiveController ..> Pageable : uses
    }
}
@enduml