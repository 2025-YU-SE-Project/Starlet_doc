@startuml
!theme toy
top to bottom direction

package "com.example.starlet_be.domains.diary" {

    enum Color << (E,#FFDDCC) Color >> {
        BLUE
        RED
        YELLOW
        GREEN
        PURPLE
        ORANGE
        --
        + values()
        + valueOf()
    }

    enum Factor << (E,#DDEEFF) Factor >> {
        WORK
        EDUCATION
        FRIEND
        TRIP
        HOBBY
        LOVER
        FAMILY
        HEALTH
        ETC
        --
        + values()
        + valueOf()
    }

    class Emotion << (E,#FFFFAA) Emotion Enum >> {
        --
        + getColor(): Color
        --
        // 상수는 내부적으로 존재합니다.
        HAPPINESS
        FUNNY
        NEUTRAL
        SURPRISING
        ANGER
        SADNESS
    }
    Emotion ..> Color

    class DiaryCreateReqDto << (D,#FFEEEE) Req DTO >> {
        - emotion: Emotion
        - factors: List<Factor>
        - content: String
        - date: LocalDate
        --
        + getEmotion(): Emotion
        + getFactors(): List<Factor>
        + getContent(): String
        + getDate(): LocalDate
    }

    class DiaryUpdateReqDto << (D,#FFEEEE) Req DTO >> {
        - date: LocalDate
        - content: String
        --
        + getDate(): LocalDate
        + getContent(): String
    }

    class DiarySummaryResDto << (D,#EEFFFF) Res DTO >> {
        - summary: String
        --
        + getSummary(): String
        + DiarySummaryResDto(...) (Builder)
    }

    class DiaryResDto << (D,#EEFFFF) Res DTO >> {
        - date: LocalDate
        - emotion: Emotion
        - color: Color
        - factors: List<Factor>
        - content: String
        --
        + DiaryResDto(...) (Builder)
        + of(d: Diary): DiaryResDto << Static Factory >>
        + getDate(): LocalDate ...
    }
    DiaryResDto ..> Color
    DiaryResDto ..> Emotion
    DiaryResDto ..> Factor

    class DiaryByDateResDto << (D,#EEFFFF) Res DTO >> {
        - hasDiary: boolean
        - date: LocalDate
        - diary: DiaryResDto
        --
        + empty(date: LocalDate): DiaryByDateResDto << Static Factory >>
        + of(diary: Diary): DiaryByDateResDto << Static Factory >>
    }
    DiaryByDateResDto ..> DiaryResDto

    class StarMonthlyResDto << (D,#EEFFFF) Res DTO >> {
        - date: LocalDate
        - color: Color
        --
        + StarMonthlyResDto(date: LocalDate, color: Color)
        + getDate(): LocalDate
        + getColor(): Color
    }
    StarMonthlyResDto ..> Color

    class Diary << (E,#CCCFFF) Entity >> {
        - id: Long
        - user: User (ManyToOne)
        - emotion: Emotion
        - factors: List<Factor> (ElementCollection)
        - content: String
        - createAt: LocalDate
        - star: Star (OneToOne)
        - version: Long
        --
        + Diary(...) (Builder)
        + updateContent(newContent: String): void
    }
    Diary o-- Emotion : <<uses>>
    Diary o-- Factor : <<uses>>
    Diary "1" -- "1" Star : <<OneToOne>> mappedBy star

    interface DiaryRepository << (R,#CCFFCC) JpaRepository >> {
        + existsByUser_IdAndCreateAt(userId: Long, date: LocalDate): boolean
        + findByUser_IdAndCreateAt(userId: Long, date: LocalDate): Optional<Diary>
        + findAllByUser_IdAndCreateAtBetweenOrderByCreateAtAsc(userId: Long, from: LocalDate, to: LocalDate): List<Diary>
        + findByIdAndUser_Id(diaryId: Long, userId: Long): Optional<Diary>
        + findAllByUserAndCreateAtBetween(user: User, start: LocalDate, end: LocalDate): List<Diary>
    }
    DiaryRepository --> Diary : manages

    class DiaryService << (S,#AADDFF) Service >> {
        - diaryRepository: DiaryRepository
        - userRepository: UserRepository
        - starRepository: StarRepository
        - entityManager: EntityManager
        - moderationService: ModerationService
        - openAIService: OpenAIService
        --
        + create(userId: Long, req: DiaryCreateReqDto): DiaryResDto
        + update(userId: Long, req: DiaryUpdateReqDto): DiaryResDto
        + getByDate(userId: Long, date: LocalDate): DiaryByDateResDto
        + getMonthlyStars(userId: Long, ym: YearMonth): List<StarMonthlyResDto>
        + delete(userId: Long, diaryId: Long): void
        + getDiaryMonthSummary(details: UserDetails, year: Integer, month: Integer): DiarySummaryResDto
        - safeFactors(in: List<Factor>): List<Factor>
    }
    DiaryService --> DiaryRepository : injects/uses
    DiaryService ..> DiaryCreateReqDto : uses
    DiaryService ..> DiaryUpdateReqDto : uses
    DiaryService ..> DiaryResDto : returns
    DiaryService ..> DiaryByDateResDto : returns
    DiaryService ..> StarMonthlyResDto : returns List
    DiaryService ..> DiarySummaryResDto : returns

    interface DiaryApi << (I,#CCCCCC) Tag/Interface >> {
        + createDiary(principal: UserDetails, req: DiaryCreateReqDto): ResponseEntity<?>
        + updateDiary(principal: UserDetails, req: DiaryUpdateReqDto): ResponseEntity<?>
        + getDiary(principal: UserDetails, date: LocalDate): ResponseEntity<DiaryByDateResDto>
        + getMonthlyStars(principal: UserDetails, year: int, month: int): ResponseEntity<List<StarMonthlyResDto>>
        + removeDiary(principal: UserDetails, diaryId: Long): ResponseEntity<?>
        + getDiaryMonthSummary(details: UserDetails, year: Integer, month: Integer): ResponseEntity<?>
    }

    class DiaryController << (C,#FFCCAA) RestController >> {
        - diaryService: DiaryService
        - userRepository: UserRepository
        --
        + createDiary(principal: UserDetails, req: DiaryCreateReqDto): ResponseEntity<DiaryResDto>
        + updateDiary(principal: UserDetails, req: DiaryUpdateReqDto): ResponseEntity<DiaryResDto>
        + getDiary(principal: UserDetails, date: LocalDate): ResponseEntity<DiaryByDateResDto>
        + getMonthlyStars(principal: UserDetails, year: int, month: int): ResponseEntity<List<StarMonthlyResDto>>
        + removeDiary(principal: UserDetails, diaryId: Long): ResponseEntity<Object>
        + getDiaryMonthSummary(details: UserDetails, year: Integer, month: Integer): ResponseEntity<?>
        - resolveUserId(principal: UserDetails): Long
    }

    DiaryController .up.|> DiaryApi : implements
    DiaryController --> DiaryService : injects/uses
    DiaryController ..> DiaryCreateReqDto : uses
    DiaryController ..> DiaryUpdateReqDto : uses
}
@enduml