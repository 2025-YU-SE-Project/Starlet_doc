@startuml
!theme toy
top to bottom direction

' --- External Dependencies (Gray) ---
class User << (E,Gray) External Entity >>
class Diary << (E,Gray) External Entity >>
class Constellation << (E,Gray) External Entity >>
enum Emotion << (E,Gray) External Enum >>
class UserRepository << (R,Gray) External Repository >>
class DiaryRepository << (R,Gray) External Repository >>
class ConstellationRepository << (R,Gray) External Repository >>
class StarRepository << (R,Gray) External Repository >>
class S3StorageService << (S,Gray) External Service >>
class ModerationService << (S,Gray) External Service >>
class PublishedObject << (D,Gray) External DTO >>
class StarryNightConstellationDto << (D,Gray) External Res DTO >>
class UserDetails << (I,Gray) External Interface >>
class ResponseEntity << (C,Gray) External Class >>

' --- Controller (#FFCCAA) ---
class mypageController << (C,#FFCCAA) RestController >> {
    - myPageService: MyPageService
    - userRepository: UserRepository
    --
    + getSummary(principal: UserDetails, year: Integer, month: Integer): ResponseEntity<MyPageSummaryResDto>
    + getUserSummary(principal: UserDetails): ResponseEntity<UserSummaryResDto>
    + getLevel(principal: UserDetails): ResponseEntity<LevelResDto>
    + getRepresentative(principal: UserDetails): ResponseEntity<?>
    + getMonthlyCount(principal: UserDetails, year: Integer): ResponseEntity<List<MonthlyCountResDto>>
    + getEmotionCount(principal: UserDetails, year: int, month: int): ResponseEntity<List<EmotionCountResDto>>
    + confirmPhoto(principal: UserDetails, req: ConfirmPhotoReqDto): ResponseEntity<ConfirmPhotoResDto>
    + updateNickname(principal: UserDetails, req: UpdateNicknameReqDto): ResponseEntity<UpdateNicknameResDto>
    + checkNickname(principal: UserDetails, newNickname: String): ResponseEntity<?>
    - resolveUserId(principal: UserDetails): Long
}

' --- Service (#AADDFF) ---
class MyPageService << (S,#AADDFF) Service >> {
    - userRepository: UserRepository
    - diaryRepository: DiaryRepository
    - constellationRepository: ConstellationRepository
    - starRepository: StarRepository
    - constellationMapper: ConstellationMapper
    - s3StorageService: S3StorageService
    - moderationService: ModerationService
    --
    + getSummary(userId: Long, year: Integer, month: Integer): MyPageSummaryResDto
    + getUserSummary(userId: Long): UserSummaryResDto
    + getLevel(userId: Long): LevelResDto
    + getRepresentativeConstellation(userId: Long): StarryNightConstellationDto
    + getMonthlyCount(userId: Long, year: int): List<MonthlyCountResDto>
    + getEmotionCount(userId: Long, year: int, month: int): List<EmotionCountResDto>
    + confirmProfilePhoto(userId: Long, tempKey: String): ConfirmPhotoResDto
    + updateNickname(userId: Long, newNickname: String): UpdateNicknameResDto
    + checkNickname(userId: Long, newNickname: String): void
}

' --- Utility & Mapper (#DDAAFF) ---
class LevelPolicy << (U,#DDAAFF) Utility >> {
    - {static} RULES: List<Rule>
    --
    + {static} resolve(totalStars: long): LevelResDto
}

class ConstellationMapper << (C,#DDAAFF) Component >> {
    + toStarryNightDto(c: Constellation): StarryNightConstellationDto
}

' --- Relationships ---
mypageController --> MyPageService : injects/uses
mypageController ..> UserRepository : uses
mypageController ..> UserDetails : uses

MyPageService --> UserRepository
MyPageService --> DiaryRepository
MyPageService --> ConstellationRepository
MyPageService --> StarRepository
MyPageService --> ConstellationMapper
MyPageService --> S3StorageService
MyPageService --> ModerationService

MyPageService ..> LevelPolicy : uses
MyPageService ..> User : uses
MyPageService ..> Diary : uses
MyPageService ..> Emotion : uses
MyPageService ..> Constellation : uses
MyPageService ..> PublishedObject : uses

ConstellationMapper ..> Constellation : uses
ConstellationMapper ..> StarryNightConstellationDto : returns

@enduml